<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>Foodprint.Web</RootNamespace>
    <!-- SSR form models keep an initializer so they are never null in markup; EditForm
         re-materialises them on each post, and handlers re-validate every field. -->
    <WarningsNotAsErrors>BL0008</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foodprint.Core\Foodprint.Core.csproj" />
  </ItemGroup>

</Project>
