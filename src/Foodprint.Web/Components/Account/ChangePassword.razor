@page "/profile/password"
@using System.ComponentModel.DataAnnotations
@using Foodprint.Core.Auth
@using Foodprint.Web.Auth
@using Foodprint.Web.Resources
@inject AuthService Auth
@inject CurrentUser Me
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Profile.ChangePassword"] · Foodprint</PageTitle>

<h1>@L["Profile.ChangePassword"]</h1>

@if (_message is not null)
{
    <p class="@(_ok ? "fp-field__hint" : "fp-field__error")" role="alert">@_message</p>
}

<FpCard>
    <EditForm Model="Input" FormName="change-password" OnValidSubmit="Submit" method="post">
        <DataAnnotationsValidator />
        <div class="fp-field">
            <label class="fp-field__label" for="current">@L["Profile.CurrentPassword"]</label>
            <InputText id="current" type="password" class="fp-input" @bind-Value="Input.Current" autocomplete="current-password" />
        </div>
        <div class="fp-field">
            <label class="fp-field__label" for="next">@L["Auth.NewPassword"]</label>
            <InputText id="next" type="password" class="fp-input" @bind-Value="Input.Next" autocomplete="new-password" />
            <span class="fp-field__hint">@L["Auth.Password.Rule"]</span>
        </div>
        <FpButton Type="submit">@L["Common.Save"]</FpButton>
    </EditForm>
</FpCard>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();

    private string? _message;
    private bool _ok;

    private async Task Submit()
    {
        HttpContext.Request.Cookies.TryGetValue(SessionAuth.CookieName, out var keep);
        var err = await Auth.ChangePasswordAsync(Me.Id, Input.Current, Input.Next, keep, HttpContext.RequestAborted);

        (_ok, _message) = err switch
        {
            PasswordChangeError.None => (true, L["Profile.Password.Changed"].Value),
            PasswordChangeError.WrongCurrent => (false, L["Profile.Password.Wrong"].Value),
            _ => (false, L["Auth.Password.Rule"].Value),
        };

        if (_ok)
        {
            Input = new InputModel();
        }
    }

    private sealed class InputModel
    {
        [Required] public string Current { get; set; } = "";
        [Required, MinLength(PasswordRules.MinLength)] public string Next { get; set; } = "";
    }
}
