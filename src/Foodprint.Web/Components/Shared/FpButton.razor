@namespace Foodprint.Web.Components.Shared

@if (Href is null)
{
    <button type="@Type"
            class="fp-btn fp-btn--@Variant @Class"
            disabled="@Disabled"
            @attributes="Extra"
            @onclick="OnClick">
        @ChildContent
    </button>
}
else
{
    <a href="@Href" class="fp-btn fp-btn--@Variant @Class" @attributes="Extra">@ChildContent</a>
}

@code {
    /// <summary>primary | secondary | danger | ghost</summary>
    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }
}
