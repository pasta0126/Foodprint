@namespace Foodprint.Web.Components.Shared

<span class="fp-chip @Class">
    @ChildContent
    @if (OnRemove.HasDelegate)
    {
        <button type="button"
                class="fp-btn fp-btn--ghost"
                style="padding:0 .25rem;line-height:1"
                aria-label="@RemoveLabel"
                @onclick="OnRemove">&times;</button>
    }
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public string RemoveLabel { get; set; } = "Remove";
    [Parameter] public string? Class { get; set; }
}
