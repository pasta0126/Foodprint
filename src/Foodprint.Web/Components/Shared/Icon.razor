@namespace Foodprint.Web.Components.Shared

@* Inline-SVG icon set. Static SSR, no script. Decorative by default
   (aria-hidden); pass Title to expose an accessible name (role="img"). *@
<svg class="fp-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Title is null ? "true" : null)"
     role="@(Title is null ? null : "img")"
     focusable="false">
    @if (Title is not null)
    {
        <title>@Title</title>
    }
    @((MarkupString)Body(Name))
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = default!;
    [Parameter] public string? Title { get; set; }
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }

    // Path data adapted from Lucide (ISC licensed). Keys are stable icon names.
    private static string Body(string name) => name switch
    {
        "today" => "<rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/>",
        "history" => "<path d='M3 12a9 9 0 1 0 3-6.7L3 8'/><path d='M3 3v5h5'/><path d='M12 7v5l3 2'/>",
        "summary" => "<path d='M3 3v18h18'/><rect x='7' y='11' width='3' height='6'/><rect x='13' y='7' width='3' height='10'/>",
        "add" => "<path d='M12 5v14M5 12h14'/>",
        "edit" => "<path d='M12 20h9'/><path d='M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z'/>",
        "delete" => "<path d='M3 6h18'/><path d='M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'/><path d='M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6'/><path d='M10 11v6M14 11v6'/>",
        "save" => "<path d='M20 6 9 17l-5-5'/>",
        "back" => "<path d='M19 12H5'/><path d='m12 19-7-7 7-7'/>",
        "signout" => "<path d='M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4'/><path d='m16 17 5-5-5-5'/><path d='M21 12H9'/>",
        "user" => "<circle cx='12' cy='8' r='4'/><path d='M4 21a8 8 0 0 1 16 0'/>",
        "group-breakfast" => "<path d='M17 8h1a4 4 0 1 1 0 8h-1'/><path d='M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z'/><path d='M6 2v2M10 2v2M14 2v2'/>",
        "group-lunch" => "<path d='M3 2v7c0 1.1.9 2 2 2h1a2 2 0 0 0 2-2V2'/><path d='M5 2v20M20 2v20'/><path d='M20 8a4 4 0 0 0-4 4v3h4'/>",
        "group-dinner" => "<path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'/>",
        "group-snack" => "<path d='M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5Z'/><path d='M8.5 8.5h.01M16 12h.01M11 15h.01'/>",
        "group-other" => "<circle cx='12' cy='12' r='2'/>",
        "plate-small" => "<circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='2.5' fill='currentColor' stroke='none'/>",
        "plate-medium" => "<circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='4.5' fill='currentColor' stroke='none'/>",
        "plate-large" => "<circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='6.5' fill='currentColor' stroke='none'/>",
        "plate-very-large" => "<circle cx='12' cy='12' r='9'/><circle cx='12' cy='12' r='8' fill='currentColor' stroke='none'/>",
        "note" => "<path d='M14 3v4a1 1 0 0 0 1 1h4'/><path d='M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z'/><path d='M9 9h1M9 13h6M9 17h6'/>",
