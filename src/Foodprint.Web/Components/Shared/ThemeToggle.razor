@namespace Foodprint.Web.Components.Shared
@rendermode InteractiveServer
@inject IJSRuntime Js

<button type="button"
        class="fp-btn fp-btn--ghost"
        aria-label="@AriaLabel"
        title="@AriaLabel"
        @onclick="Cycle">
    @Icon
</button>

@code {
    // "system" -> "light" -> "dark" -> "system"
    private string _mode = "system";

    private string Icon => _mode switch { "light" => "☀️", "dark" => "\U0001F319", _ => "\U0001F5A5️" };
    private string AriaLabel => $"Theme: {_mode}. Activate to change.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _mode = await Js.InvokeAsync<string>("fpTheme.get");
            StateHasChanged();
        }
    }

    private async Task Cycle()
    {
        _mode = _mode switch { "system" => "light", "light" => "dark", _ => "system" };
        await Js.InvokeVoidAsync("fpTheme.set", _mode);
    }
}
