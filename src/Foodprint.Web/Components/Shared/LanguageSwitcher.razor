@namespace Foodprint.Web.Components.Shared
@using System.Globalization
@using Foodprint.Core.Localization
@using Foodprint.Web.Resources
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<form method="post" action="/profile/language" style="margin:0">
    <input type="hidden" name="returnUrl" value="@ReturnPath" />
    <select name="language"
            class="fp-select"
            style="width:auto;padding-block:var(--fp-space-1)"
            aria-label="@L["Language.Label"]"
            onchange="this.form.submit()">
        @foreach (var lang in SupportedLanguages.All)
        {
            <option value="@lang" selected="@(lang == Current)">@L[$"Language.{lang}"]</option>
        }
    </select>
</form>

@code {
    private string Current => SupportedLanguages.Match(CultureInfo.CurrentUICulture.Name) ?? SupportedLanguages.Default;
    private string ReturnPath => new Uri(Nav.Uri).PathAndQuery;
}
