@namespace Foodprint.Web.Components.Layout
@inherits LayoutComponentBase
@using Foodprint.Web.Components.Shared
@using Foodprint.Web.Resources
@inject IStringLocalizer<SharedResource> L

<div class="fp-shell">
    <header class="fp-shell__header">
        <a class="fp-shell__brand" href="/">@L["App.Name"]</a>

        <input type="checkbox" id="fp-nav-toggle" class="fp-shell__nav-checkbox" aria-hidden="true" />
        <label for="fp-nav-toggle" class="fp-btn fp-btn--ghost fp-shell__nav-toggle" aria-label="@L["Nav.Toggle"]">☰</label>

        <nav class="fp-shell__nav" aria-label="Primary">
            <NavLink href="/" Match="NavLinkMatch.All">@L["Nav.Today"]</NavLink>
            <NavLink href="/history">@L["Nav.History"]</NavLink>
            <NavLink href="/summary">@L["Nav.Weekly"]</NavLink>
            <NavLink href="/profile">@L["Nav.Profile"]</NavLink>
        </nav>

        <div class="fp-shell__tools">
            <LanguageSwitcher />
            <ThemeToggle />
            <form method="post" action="/auth/sign-out" style="margin:0">
                <button type="submit" class="fp-btn fp-btn--ghost">@L["Nav.SignOut"]</button>
            </form>
        </div>
    </header>

    <main class="fp-shell__main">
        @Body
    </main>
</div>
