@page "/"
@page "/day/{Date}"
@using Foodprint.Core.Meals
@using Foodprint.Core.Profiles
@using Foodprint.Web.Auth
@using Foodprint.Web.Components.Meals
@using Foodprint.Web.Localization
@using Foodprint.Web.Resources
@inject DiaryService Diary
@inject CurrentUser Me
@inject IStringLocalizer<SharedResource> L

<PageTitle>@Heading · Foodprint</PageTitle>

<div class="fp-dayhead">
    <a class="fp-btn fp-btn--ghost" href="@Link(_date.AddDays(-1))" aria-label="@L["Day.Previous"]">‹</a>
    <h1>@Heading</h1>
    <a class="fp-btn fp-btn--ghost" href="@Link(_date.AddDays(1))" aria-label="@L["Day.Next"]">›</a>
</div>

<p><FpButton Href="@($"/entries/new?date={_date:yyyy-MM-dd}")">@L["Day.AddEntry"]</FpButton></p>

@if (_day is null)
{
    <p>…</p>
}
else if (_day.Entries.Count == 0)
{
    <FpCard>
        <p>@L["Day.Empty"]</p>
    </FpCard>
}
else
{
    <div class="fp-entry-list">
        @foreach (var entry in _day.Entries)
        {
            <MealEntryCard Entry="entry" Zone="_zone" />
        }
    </div>
}

@code {
    [Parameter] public string? Date { get; set; }

    private DateOnly _date;
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;
    private DiaryDay? _day;

    private string Heading => _date == Today ? L["Nav.Today"] : LocalFormats.LongDate(_date);
    private DateOnly Today => DayRange.LocalDate(DateTime.UtcNow, _zone);
    private static string Link(DateOnly d) => $"/day/{d:yyyy-MM-dd}";

    protected override async Task OnParametersSetAsync()
    {
        _zone = ProfileService.ResolveZone(Me.TimeZoneId);
        _date = DateOnly.TryParseExact(Date, "yyyy-MM-dd", out var parsed) ? parsed : Today;
        _day = await Diary.GetDayAsync(Me.Id, _date, _zone);
    }
}
