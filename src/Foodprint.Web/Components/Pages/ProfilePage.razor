@page "/profile"
@using System.ComponentModel.DataAnnotations
@using Foodprint.Core.Localization
@using Foodprint.Core.Profiles
@using Foodprint.Web.Auth
@using Foodprint.Web.Resources
@inject ProfileService Profiles
@inject CurrentUser Me
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Profile.Title"] · Foodprint</PageTitle>

<h1>@L["Profile.Title"]</h1>

@if (_message is not null)
{
    <p class="@(_ok ? "fp-field__hint" : "fp-field__error")" role="alert">@_message</p>
}

<FpCard>
    <EditForm Model="Input" FormName="profile" OnValidSubmit="Save" method="post">
        <DataAnnotationsValidator />

        <div class="fp-field">
            <label class="fp-field__label" for="name">@L["Auth.DisplayName"]</label>
            <InputText id="name" class="fp-input" @bind-Value="Input.DisplayName" />
            <ValidationMessage For="() => Input.DisplayName" />
        </div>

        <div class="fp-field">
            <label class="fp-field__label" for="tz">@L["Profile.TimeZone"]</label>
            <InputSelect id="tz" class="fp-select" @bind-Value="Input.TimeZoneId">
                @foreach (var tz in _zones)
                {
                    <option value="@tz">@tz</option>
                }
            </InputSelect>
        </div>

        <div class="fp-field">
            <label class="fp-field__label" for="lang">@L["Language.Label"]</label>
            <InputSelect id="lang" class="fp-select" @bind-Value="Input.Language">
                @foreach (var lang in SupportedLanguages.All)
                {
                    <option value="@lang">@L[$"Language.{lang}"]</option>
                }
            </InputSelect>
        </div>

        <FpButton Type="submit">@L["Common.Save"]</FpButton>
    </EditForm>
</FpCard>

<FpCard class="fp-mt">
    <div class="fp-field">
        <span class="fp-field__label">@L["Profile.Theme"]</span>
        <div class="fp-theme" id="fp-theme-control" role="group" aria-label="@L["Profile.Theme"]">
            <button type="button" class="fp-btn fp-btn--secondary" data-theme-choice="system"
                    onclick="fpTheme.set('system');fpThemeSync()">@L["Theme.System"]</button>
            <button type="button" class="fp-btn fp-btn--secondary" data-theme-choice="light"
                    onclick="fpTheme.set('light');fpThemeSync()">@L["Theme.Light"]</button>
            <button type="button" class="fp-btn fp-btn--secondary" data-theme-choice="dark"
                    onclick="fpTheme.set('dark');fpThemeSync()">@L["Theme.Dark"]</button>
        </div>
    </div>
    <script>
        function fpThemeSync() {
            var m = (window.fpTheme && fpTheme.get()) || "system";
            document.querySelectorAll('#fp-theme-control [data-theme-choice]').forEach(function (b) {
                b.setAttribute('aria-pressed', String(b.dataset.themeChoice === m));
            });
        }
        fpThemeSync();
    </script>
</FpCard>

<FpCard class="fp-mt">
    <div class="fp-field">
        <span class="fp-field__label">@L["Profile.Export"]</span>
        <span class="fp-field__hint">@L["Profile.Export.Help"]</span>
    </div>
    <form method="get" action="/profile/export">
        <div class="fp-field">
            <label class="fp-field__label" for="export-from">@L["Export.From"]</label>
            <input type="date" id="export-from" name="from" value="@_exportFrom" class="fp-input" />
        </div>
        <div class="fp-field">
            <label class="fp-field__label" for="export-to">@L["Export.To"]</label>
            <input type="date" id="export-to" name="to" value="@_exportTo" class="fp-input" />
        </div>
        <FpButton Type="submit" Variant="secondary">@L["Export.Download"]</FpButton>
    </form>
</FpCard>

<p style="margin-top:var(--fp-space-4)">
    <FpButton Href="/profile/password" Variant="secondary">@L["Profile.ChangePassword"]</FpButton>
</p>

<form method="post" action="/auth/sign-out" style="margin-top:var(--fp-space-4)">
    <FpButton Type="submit" Variant="secondary">@L["Profile.SignOut"]</FpButton>
</form>

@code {
    private static readonly string[] _zones =
        TimeZoneInfo.GetSystemTimeZones().Select(z => z.Id).OrderBy(z => z, StringComparer.Ordinal).ToArray();

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private Model Input { get; set; } = new();

    private string? _message;
    private bool _ok;
    private string _exportFrom = "";
    private string _exportTo = "";

    protected override async Task OnInitializedAsync()
    {
        var zone = ProfileService.ResolveZone(Me.TimeZoneId);
        var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, zone));
        _exportTo = today.ToString("yyyy-MM-dd");
        _exportFrom = today.AddDays(-30).ToString("yyyy-MM-dd");

        if (HttpContext.Request.Method == "GET")
        {
            var view = await Profiles.GetAsync(Me.Id, HttpContext.RequestAborted);
            if (view is not null)
            {
                Input = new Model
                {
                    DisplayName = view.DisplayName,
                    TimeZoneId = _zones.Contains(view.TimeZoneId) ? view.TimeZoneId : "Etc/UTC",
                    Language = view.Language,
                };
            }
        }
    }

    private async Task Save()
    {
        var error = await Profiles.UpdateAsync(
            Me.Id, Input.DisplayName, Input.TimeZoneId, Input.Language, HttpContext.RequestAborted);

        if (error == ProfileError.None)
        {
            // Reload so the language claim (rebuilt from the profile each request) applies.
            Nav.NavigateTo("/profile", forceLoad: true);
            return;
        }

        (_ok, _message) = error switch
        {
            ProfileError.InvalidTimeZone => (false, L["Profile.TimeZone.Invalid"].Value),
            ProfileError.InvalidName => (false, L["Auth.DisplayName.Invalid"].Value),
            _ => (false, L["Profile.TimeZone.Invalid"].Value),
        };
    }

    private sealed class Model
    {
        [Required, StringLength(80, MinimumLength = 1)]
        public string DisplayName { get; set; } = "";

        public string TimeZoneId { get; set; } = "Etc/UTC";
        public string Language { get; set; } = SupportedLanguages.Default;
    }
}
