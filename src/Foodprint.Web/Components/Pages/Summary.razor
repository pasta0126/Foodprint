@page "/summary"
@using Foodprint.Core.Meals
@using Foodprint.Core.Profiles
@using Foodprint.Web.Auth
@using Foodprint.Web.Localization
@using Foodprint.Web.Resources
@inject SummaryService Summaries
@inject CurrentUser Me
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nav.Weekly"] · Foodprint</PageTitle>

<h1>@L["Nav.Weekly"]</h1>

@if (_summary is null)
{
    <p>…</p>
}
else
{
    <p style="color:var(--fp-text-muted)">@LocalFormats.MediumDate(_summary.From) – @LocalFormats.MediumDate(_summary.To)</p>

    <FpCard Title="@(L["Summary.Streak"])">
        <p style="font-size:var(--fp-fs-2xl);font-weight:700;margin:0">@_summary.Streak</p>
        <p style="margin:0;color:var(--fp-text-muted)">@L["Summary.Streak.Unit", _summary.Streak]</p>
    </FpCard>

    <FpCard Title="@(L["Summary.PerDay"])" Class="fp-mt">
        <div class="fp-bars">
            @foreach (var day in _summary.PerDay)
            {
                <div class="fp-bar">
                    <div class="fp-bar__fill" style="height:@(BarHeight(day.Count))%"></div>
                    <div class="fp-bar__count">@day.Count</div>
                    <div class="fp-bar__label">@LocalFormats.ShortWeekday(day.Date)</div>
                </div>
            }
        </div>
    </FpCard>

    <FpCard Title="@(L["Summary.TopTags"])" Class="fp-mt">
        @if (_summary.TopTags.Count == 0)
        {
            <p style="color:var(--fp-text-muted)">@L["Summary.TopTags.Empty"]</p>
        }
        else
        {
            <ul class="fp-taglist">
                @foreach (var tag in _summary.TopTags)
                {
                    <li><span class="fp-chip">#@tag.Tag</span> <span style="color:var(--fp-text-muted)">@tag.Count</span></li>
                }
            </ul>
        }
    </FpCard>
}

@code {
    private WeeklySummary? _summary;

    protected override async Task OnInitializedAsync()
    {
        var zone = ProfileService.ResolveZone(Me.TimeZoneId);
        var today = DayRange.LocalDate(DateTime.UtcNow, zone);
        _summary = await Summaries.GetAsync(Me.Id, zone, today);
    }

    private int BarHeight(int count)
    {
        var max = _summary!.PerDay.Max(d => d.Count);
        return max == 0 ? 0 : (int)Math.Round(count * 100.0 / max);
    }
}
